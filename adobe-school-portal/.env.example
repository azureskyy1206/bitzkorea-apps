# PostgreSQL
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
POSTGRES_DB=adobe_school_portal
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://portal:portal@db:5432/adobe_school_portal

# Redis / Queue
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6380

# Adobe UMAPI — CY25-H2 (2025 하반기 콘솔)
ADOBE_ORG_ID=
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_IMS_HOST=https://ims-na1.adobelogin.com
ADOBE_DEFAULT_PRODUCT_PROFILE_ID=
ADOBE_UMAPI_HOST=https://usermanagement.adobe.io
ADOBE_USER_COUNTRY=KR

# Adobe UMAPI — CY26-H1 (2026 상반기, Client ID/Secret 필수 — Org/프로필은 하반기와 같을 수 있음)
ADOBE_ORG_ID_CY26_H1=126D2371682531D50A495EAF@AdobeOrg
ADOBE_CLIENT_ID_CY26_H1=
ADOBE_CLIENT_SECRET_CY26_H1=
ADOBE_DEFAULT_PRODUCT_PROFILE_ID_CY26_H1=기본 K-12용 CCE 모든 앱 구성

# Auth / Admin
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me-admin-password
# 선택: curl·자동화용 (웹 UI는 ADMIN_PASSWORD 사용)
ADMIN_API_KEY=

# App
LOG_LEVEL=INFO
ENVIRONMENT=development
TZ=Asia/Seoul

# Web (Next.js)
# 로컬: http://localhost:8010  |  운영(Nginx): https://adobe.bitzkorea.com/backend-api
NEXT_PUBLIC_API_URL=http://localhost:8010
WEB_PORT=3010
API_PORT=8010

# docker-compose web 컨테이너 내부 API (서버 컴포넌트 fetch)
# INTERNAL_API_URL=http://api:8010

# Optional: 이메일 MX 레코드 검증 (Phase 3+)
# EMAIL_MX_CHECK=false

# Microsoft 365 — 로그인 안내 메일 (Adobe@bitzkorea.com 발신)
# Azure Portal → Microsoft Entra ID → 앱 등록 → API 권한: Mail.Send (Application)
# 관리자 동의 후 아래 값 입력. EMAIL_ENABLED=true 로 활성화.
# EMAIL_ENABLED=false
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# MAIL_FROM_ADDRESS=Adobe@bitzkorea.com
# 공용 사서함이면 이메일 대신 Azure AD 「개체 ID」 사용 (404 ErrorInvalidUser 시)
# MAIL_FROM_USER_ID=
# PORTAL_PUBLIC_URL=https://adobe.bitzkorea.com
