# Sales Support (Next.js + FastAPI)
# Root /home/azureuser/.gitignore covers most patterns; this file applies when
# working inside app/ as a standalone repo.

# Secrets
.env
.env.*
!.env.example
!.env.*.example
!.env.local.example

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node / Next.js
node_modules/
web/node_modules/
.next/
web/.next/
out/
.vercel/
*.tsbuildinfo

# Runtime data & uploads
data/
data.empty/

# Database
*.db
pgdata/

# Logs & cache
*.log
**/.editor-cache/
**/ledger-edit-logs/
**/daily-backups/

# OS
.DS_Store
