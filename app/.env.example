# PostgreSQL (docker-compose.infra.yml 기본값과 맞출 것)
POSTGRES_DSN=postgresql+psycopg://sales:sales_dev_pw_change_me@sales-postgres:5432/sales_tracker

# Redis
REDIS_URL=redis://sales-redis:6379/0

# Ollama (AI 기능)
OLLAMA_URL=http://sales-ollama:11434

# 업로드·백업·로그 저장 경로 (컨테이너 내부)
UPLOAD_DIR=/data/uploads

# 세션 쿠키 (운영 환경에서는 반드시 변경)
SESSION_SECRET=change-me-to-a-long-random-string

# HTTPS 프록시 뒤에서 세션 쿠키 Secure 플래그 (Nginx TLS 사용 시 true)
HTTPS_ONLY=true

# 최초 관리자 계정 (DB에 사용자 없을 때만 생성)
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=changeme

# Next.js (브라우저 → API). docker-compose.yml에서 web 서비스에 전달
NEXT_PUBLIC_API_URL=https://itc.bitzkorea.com

# 타임존
TZ=Asia/Seoul
